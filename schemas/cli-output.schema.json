{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bna.dev/schemas/cli-output/1.0.0.json",
  "title": "BNA CLI JSON output",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "toolVersion",
    "generatedAt",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "tool": {
      "enum": [
        "validate",
        "probe",
        "verify",
        "audit-score",
        "reconcile"
      ]
    },
    "toolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "required": [
        "format",
        "detachedJws",
        "algorithm"
      ],
      "properties": {
        "format": {
          "const": "detached-jws"
        },
        "detachedJws": {
          "type": "string",
          "pattern": "^[^.]+\\.\\.[^.]+$"
        },
        "algorithm": {
          "enum": [
            "EdDSA",
            "RS256"
          ]
        },
        "keyId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/validationResult"
        },
        {
          "$ref": "#/$defs/probeResult"
        },
        {
          "$ref": "#/$defs/verificationResult"
        },
        {
          "$ref": "#/$defs/auditScoreResult"
        },
        {
          "$ref": "#/$defs/reconcileResult"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "validationResult": {
      "type": "object",
      "required": [
        "report"
      ],
      "properties": {
        "report": {
          "type": "object",
          "required": [
            "verdict",
            "errors",
            "warns",
            "fields"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "ok",
                "warn",
                "err"
              ]
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "warns": {
              "type": "integer",
              "minimum": 0
            },
            "fields": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "probeResult": {
      "description": "summary is a BNA probe-protocol summary. Its authoritative definition is https://bna.dev/schemas/probe-summary/1.0.0.json, shipped in @bna/probe-protocol; the constraints repeated here are the subset this envelope depends on. test/probe-protocol.test.js validates real probe output against the published schema so the two cannot drift.",
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "object",
          "required": [
            "specVersion",
            "target",
            "vantagePoint",
            "attempted",
            "success",
            "failure",
            "notAttempted",
            "samples"
          ],
          "properties": {
            "specVersion": {
              "const": "1.0.0"
            },
            "target": {
              "type": "string"
            },
            "vantagePoint": {
              "type": "string",
              "const": "single-local"
            },
            "attempted": {
              "type": "integer",
              "minimum": 0
            },
            "success": {
              "type": "integer",
              "minimum": 0
            },
            "failure": {
              "type": "integer",
              "minimum": 0
            },
            "notAttempted": {
              "type": "integer",
              "minimum": 0
            },
            "samples": {
              "type": "array"
            }
          }
        },
        "observations": {
          "type": "array",
          "description": "Observation leaves, one per sample, in probe order. Each carries the nonce that was sent in the request's BNA-Probe-Nonce header, fixed before the outcome was known. Authoritative definition: https://bna.dev/schemas/observation-leaf/1.0.0.json in @bna/witness-log.",
          "items": {
            "type": "object",
            "required": [
              "leafVersion",
              "type",
              "nonce",
              "requestedAt",
              "outcome",
              "ms"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "verificationResult": {
      "type": "object",
      "required": [
        "valid"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "keyId": {
          "type": "string"
        },
        "algorithm": {
          "enum": [
            "EdDSA",
            "RS256"
          ]
        }
      },
      "additionalProperties": false
    },
    "auditScoreResult": {
      "description": "The verdict of verifying a score bundle offline. `backed` is true only when every step passed: inclusion proofs, consistency against a previously held tree head if one was supplied, re-derivation of the arithmetic, and the absence of poisoned leaves.",
      "type": "object",
      "required": [
        "agentId",
        "period",
        "backed",
        "steps",
        "derived"
      ],
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "type": "string"
        },
        "period": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "backed": {
          "type": "boolean"
        },
        "leafCount": {
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step",
              "name",
              "passed"
            ],
            "additionalProperties": false,
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "name": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "derived": {
          "type": [
            "object",
            "null"
          ]
        },
        "claimed": {
          "type": [
            "object",
            "null"
          ]
        },
        "grades": {
          "type": "object",
          "description": "Evidence-grade counts, disclosure only. These describe what can be checked about BNA's measurement, not about the agent, and they never enter the arithmetic in `derived`.",
          "additionalProperties": false,
          "properties": {
            "attested": {
              "type": "integer",
              "minimum": 0
            },
            "logged": {
              "type": "integer",
              "minimum": 0
            },
            "disputed": {
              "type": "integer",
              "minimum": 0
            },
            "poisoned": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "reconcileResult": {
      "description": "What a vendor's own access log says about BNA's published measurements of them. Computed on the vendor's machine; BNA is not in the trust path.",
      "type": "object",
      "required": [
        "agentId",
        "leaves",
        "matched",
        "discrepancies",
        "byClass"
      ],
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "type": "string"
        },
        "leaves": {
          "type": "integer",
          "minimum": 0
        },
        "logLines": {
          "type": "integer",
          "minimum": 0
        },
        "logFormat": {
          "type": "string"
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "statusDisagrees": {
          "type": "integer",
          "minimum": 0
        },
        "attested": {
          "type": "integer",
          "minimum": 0
        },
        "discrepancies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "class",
              "nonce",
              "detail"
            ],
            "additionalProperties": false,
            "properties": {
              "class": {
                "enum": [
                  "no_such_request",
                  "status_mismatch",
                  "timing_mismatch",
                  "receipt_forged"
                ]
              },
              "nonce": {
                "type": "string"
              },
              "requestedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "byClass": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
